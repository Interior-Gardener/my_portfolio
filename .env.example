# Comma-separated Groq API keys (https://console.groq.com/keys). The assistant rotates between them.
GROQ_API_KEYS=gsk_first_key,gsk_second_key
# Optional: override the model used by the "Ask about my work" assistant.
GROQ_MODEL=openai/gpt-oss-20b
# Optional at build time: the public URL of the deployed site (used for canonical links, sitemap and social cards).
SITE_URL=https://your-site.pages.dev

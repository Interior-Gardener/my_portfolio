---
import "@fontsource-variable/bricolage-grotesque/standard.css";
import "@fontsource-variable/onest";
import "@fontsource-variable/martian-mono";
import "../styles/global.css";
import "../styles/experience.css";
import { getImage } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AskPanel from "../components/AskPanel.astro";
import GestureMode from "../components/GestureMode.astro";
import Lightbox from "../components/Lightbox.astro";
import { profile } from "../data/site";
import brandLogo from "../assets/brand/kv-logo.png";
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url";
import bodyFont from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  navMode?: "home" | "page";
}

const { title, description = profile.description, image = "/og.png", type = "website", jsonLd, navMode = "page" } = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
const introLogo = await getImage({ src: brandLogo, width: 460, format: "webp" });
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#060609" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={introLogo.src} as="image" fetchpriority="high" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.dataset.theme = theme;
        try {
          if (!sessionStorage.getItem("kv-intro-seen") && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.classList.add("is-preloading");
            setTimeout(() => {
              if (!window.__kvPreloaderStarted) root.classList.remove("is-preloading");
            }, 6000);
          }
        } catch {}
      })();
    </script>
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <div class="preloader" data-preloader aria-hidden="true">
      <div class="preloader__stage">
        <div class="preloader__badge">
          <svg class="preloader__ring" viewBox="0 0 120 120">
            <circle class="preloader__track" cx="60" cy="60" r="58" pathLength="100"></circle>
            <circle class="preloader__progress" data-preloader-ring cx="60" cy="60" r="58" pathLength="100"></circle>
          </svg>
          <img class="preloader__logo" data-preloader-logo src={introLogo.src} width="230" height="230" alt="" decoding="async" fetchpriority="high" />
        </div>
        <p class="preloader__name">{profile.name}</p>
        <p class="preloader__tag">{profile.tagline}</p>
        <span class="preloader__count" data-preloader-count>0</span>
      </div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="bg-canvas" data-bg aria-hidden="true"></canvas>

    <Nav mode={navMode} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <AskPanel />
    <GestureMode />
    <Lightbox />
    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <div class="cursor" data-cursor-root aria-hidden="true">
      <div class="cursor__ring" data-cursor-ring>
        <div class="cursor__shape" data-cursor-shape></div>
        <span class="cursor__label" data-cursor-label></span>
      </div>
      <div class="cursor__dot" data-cursor-dot></div>
    </div>

    <script>
      import "../scripts/preloader";
      import "../scripts/theme";
      import "../scripts/smooth";
      import "../scripts/background";
      import "../scripts/hero";
      import "../scripts/motion";
      import "../scripts/ui";
      import "../scripts/cursor";
      import "../scripts/ask";
      import "../scripts/gesture";
    </script>
  </body>
</html>

---
import "@fontsource-variable/bricolage-grotesque/standard.css";
import "@fontsource-variable/onest";
import "@fontsource-variable/martian-mono";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import AskPanel from "../components/AskPanel.astro";
import GestureMode from "../components/GestureMode.astro";
import Lightbox from "../components/Lightbox.astro";
import { profile } from "../data/site";
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url";
import bodyFont from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
  navMode?: "home" | "page";
}

const { title, description = profile.description, image = "/og.png", type = "website", jsonLd, navMode = "page" } = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.dataset.theme = theme;
      })();
    </script>
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="signal-field" data-signal-field aria-hidden="true"></canvas>
    <div class="signal-glow" aria-hidden="true"></div>

    <Nav mode={navMode} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <AskPanel />
    <GestureMode />
    <Lightbox />
    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script>
      import "../scripts/theme";
      import "../scripts/field";
      import "../scripts/hero";
      import "../scripts/ui";
      import "../scripts/ask";
      import "../scripts/gesture";
    </script>
  </body>
</html>
